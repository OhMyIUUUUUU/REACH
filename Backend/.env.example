APP_NAME="REACH Backend Service"
APP_VERSION="1.0.0"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8080
DEBUG=True

# Database Configuration (PostgreSQL)
# For local dev without Postgres running, can fallback to SQLite: sqlite:///./reach_dev.db
DATABASE_URL=postgresql://reach_user:reach_password@localhost:5432/reach_db

# Security & Authentication (JWT)
JWT_SECRET_KEY=reach_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
